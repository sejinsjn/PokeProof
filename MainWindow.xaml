<Window x:Class="PokeSqueeze.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokeProof – Tauschbelege"
        Width="1120" Height="760" MinWidth="900" MinHeight="620"
        ResizeMode="CanResize"
        Background="#F3F5F8"
        FontFamily="Segoe UI"
        Foreground="#202938">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3478D4" />
        <SolidColorBrush x:Key="MutedBrush" Color="#647184" />
        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#E8EDF4" />
            <Setter Property="Foreground" Value="#202938" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Margin" Value="0,7,0,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#D7DEE8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="PokeProof" FontSize="23" FontWeight="Bold" />
                <TextBlock Text="Videos für Tauschbelege vorbereiten" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Einstellungen" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="Ausgabe" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <CheckBox Content="Für jedes Video einen Ordner erstellen"
                                  IsChecked="{Binding CreateFolder, Mode=TwoWay}" />
                        <CheckBox Content="Tauschverlauf als Textdatei speichern"
                                  IsChecked="{Binding AddTradeHistory, Mode=TwoWay}" />
                        <TextBox Text="{Binding TradeHistory, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 MinHeight="90" MaxHeight="150" Margin="0,0,0,8"
                                 IsEnabled="{Binding AddTradeHistory}"
                                 ToolTip="Dieser Text wird als TradeHistory.txt im Ausgabeordner gespeichert." />

                        <Separator Margin="0,10,0,8" />
                        <CheckBox Content="Videos umbenennen" IsChecked="{Binding RenameVideos, Mode=TwoWay}" />
                        <Grid Margin="0,0,0,8" IsEnabled="{Binding RenameVideos}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Startnummer" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding TernaryNumberStart, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="9" PreviewTextInput="TernaryNumberStart_PreviewTextInput" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Dateiendung" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FileEnding, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Nummern werden im Ternärsystem fortlaufend vergeben."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

                        <Separator Margin="0,14,0,8" />
                        <CheckBox Content="Video komprimieren (Ton wird entfernt)"
                                  IsChecked="{Binding CompressVideos, Mode=TwoWay}" />
                        <TextBlock Text="Komprimierung" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,4" />
                        <ComboBox ItemsSource="{Binding GraphicsCardList}" SelectedItem="{Binding GraphicsCard, Mode=TwoWay}"
                                  IsEnabled="{Binding CompressVideos}" Padding="7" />
                        <TextBlock Text="AMD: HEVC, höchste Qualitätsstufe. NVIDIA: HEVC NVENC."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <Separator Margin="0,14,0,8" />
                        <TextBlock Text="{Binding SelectedFilesText}" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Button Content="Videos auswählen…" Command="{Binding OpenFilesCommand}" Margin="0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="74" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Warteschlange" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding QueueSummary}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Hinzufügen" Command="{Binding AddToQueueCommand}" />
                            <Button Content="Verarbeitung starten" Command="{Binding StartProcessCommand}"
                                    Background="{StaticResource AccentBrush}" Foreground="White" Margin="0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <ListBox ItemsSource="{Binding Queue}" BorderThickness="0"
                                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="22" />
                                                <RowDefinition Height="18" />
                                                <RowDefinition Height="18" />
                                                <RowDefinition Height="18" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SourceFileName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip="{Binding OldFilePath}" />
                                            <Button Grid.Column="1" Grid.RowSpan="3" Content="Entfernen"
                                                    Padding="8,4" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Grid.Row="1" Text="{Binding NewFilePath}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding NewFilePath}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                                       ToolTip="{Binding ErrorMessage}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding Progress}"
                                                         Height="8" VerticalAlignment="Center" Margin="0,5,8,0" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProgressText}"
                                                       FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" Margin="8,3,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Noch keine Videos in der Warteschlange. Wähle links Videos aus und füge sie hier hinzu."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="320" TextAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QueueCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="2" Background="#F6F8FB" CornerRadius="6" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding QueueStatus}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding QueueStatus}" FontSize="12" Margin="0,0,0,8" />
                            <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding QueueProgress, Mode=OneWay}"
                                         Height="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
